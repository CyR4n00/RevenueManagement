# demo | production.  Production rejects simulated market data by default.
APP_ENV=demo
DATABASE_URL=sqlite:///./revenue_assistant.db

# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:3000

# Set this in production.  Mutating API calls require this value in X-Admin-Key.
ADMIN_API_KEY=

# Apify.  Configure the actor IDs that have been validated for each OTA.
APIFY_API_TOKEN=
APIFY_ACTOR_BOOKING=
APIFY_ACTOR_AIRBNB=
APIFY_ACTOR_JALAN=
APIFY_ACTOR_RAKUTEN=

# Use only for a sales demo.  Do not set to true in production.
ALLOW_SIMULATED_DATA=true

# LINE Messaging API (LINE Notify is no longer supported).
LINE_CHANNEL_ACCESS_TOKEN=
LINE_USER_ID=

# Stripe Billing.  Use test-mode values locally; do not expose the secret key.
FRONTEND_APP_URL=http://localhost:3000
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=

# Scheduler behaviour.  Demo uses a short interval; production uses a daily job.
SCHEDULER_ENABLED=true
DEMO_SYNC_INTERVAL_MINUTES=30
DAILY_SYNC_HOUR=10
DAILY_SYNC_MINUTE=0
