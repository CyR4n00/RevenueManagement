# demo | production.  Production rejects simulated market data by default.
APP_ENV=demo
DATABASE_URL=sqlite:///./revenue_assistant.db

# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:3000

# Supabase Auth.  The publishable key is safe for browser use; do not put a
# secret/service key in frontend code.  Production requires these values.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_AUTH_REQUIRED=false

# Local acceptance testing only. Never enable this in production.
DEMO_BYPASS_BILLING=false

# Apify.  Configure the actor IDs that have been validated for each OTA.
APIFY_API_TOKEN=
APIFY_ACTOR_BOOKING=
APIFY_ACTOR_AIRBNB=
APIFY_ACTOR_JALAN=
APIFY_ACTOR_RAKUTEN=
APIFY_MONTHLY_RUN_LIMIT=0

# Platform-managed permission register.  Leave sources pending until the
# provider's terms, official API, or written permission has been verified.
OTA_STATUS_BOOKING=pending
OTA_STATUS_AIRBNB=pending
OTA_STATUS_JALAN=pending
OTA_STATUS_RAKUTEN=pending

# Use only for a sales demo.  Do not set to true in production.
ALLOW_SIMULATED_DATA=true

# Transactional alert email. The recipient is always the verified login email.
RESEND_API_KEY=
ALERT_FROM_EMAIL=レベナビ <alerts@example.com>

# Stripe Billing.  Use test-mode values locally; do not expose the secret key.
FRONTEND_APP_URL=http://localhost:3000
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_UPGRADE=

# Verified operator accounts and public business identity. Keep operator
# access separate from ordinary customer accounts.
OPERATOR_EMAILS=operator@example.com
BUSINESS_NAME=
BUSINESS_REPRESENTATIVE=
BUSINESS_ADDRESS=
BUSINESS_PHONE=
SUPPORT_EMAIL=

# Scheduler behaviour. Keep this false on Cloud Run services and invoke
# backend/sync_job.py from Cloud Run Jobs to prevent duplicate executions.
SCHEDULER_ENABLED=true
DEMO_SYNC_INTERVAL_MINUTES=30
DAILY_SYNC_HOURS=9,18
DAILY_SYNC_MINUTE=0
SYNC_LOOKAHEAD_DAYS=90
